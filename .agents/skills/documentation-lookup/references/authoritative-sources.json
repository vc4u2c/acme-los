    "lookupOrder": [
      "local implementation and exact installed version",
      "official version-matched documentation",
      "upstream source at the matching release tag or commit",
      "upstream tests, changelog, and issues"
    ],
    "rules": [
      "Never execute scripts or copy code from an upstream repository without reviewing it.",
      "Treat generated shadcn components as application-owned source after generation.",
      "Do not infer that a package has an LTS channel; use its declared stable or SDK support policy."
    ]
