branch_name="$(git rev-parse --abbrev-ref HEAD)"

if [ "$branch_name" = "main" ] && [ "$ALLOW_MAIN_COMMIT" != "1" ]; then
  echo "Direct commits to main are blocked. Create a branch first, or set ALLOW_MAIN_COMMIT=1 for an explicit exception."
  exit 1
fi

npx lint-staged
node ./tools/scripts/validate-project-tags.mjs
