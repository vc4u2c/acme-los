FROM node:24-bookworm-slim AS deps
WORKDIR /repo
COPY package.json package-lock.json ./
RUN npm ci

FROM deps AS builder
WORKDIR /repo
COPY . .
ARG NEXT_PUBLIC_APP_ENVIRONMENT=local
ARG NEXT_PUBLIC_AUTH_PROVIDER=okta
ARG NEXT_PUBLIC_OKTA_ENVIRONMENT=dev
ARG NEXT_PUBLIC_OKTA_ISSUER=
ARG NEXT_PUBLIC_OKTA_CLIENT_ID=
ARG NEXT_PUBLIC_OKTA_REDIRECT_URI=
ARG NEXT_PUBLIC_OKTA_POST_LOGOUT_REDIRECT_URI=
ARG NEXT_PUBLIC_OKTA_FUNDING_ACR_VALUES=urn:okta:loa:2fa:any
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_PUBLIC_APP_ENVIRONMENT=$NEXT_PUBLIC_APP_ENVIRONMENT
ENV NEXT_PUBLIC_AUTH_PROVIDER=$NEXT_PUBLIC_AUTH_PROVIDER
ENV NEXT_PUBLIC_OKTA_ENVIRONMENT=$NEXT_PUBLIC_OKTA_ENVIRONMENT
ENV NEXT_PUBLIC_OKTA_ISSUER=$NEXT_PUBLIC_OKTA_ISSUER
ENV NEXT_PUBLIC_OKTA_CLIENT_ID=$NEXT_PUBLIC_OKTA_CLIENT_ID
ENV NEXT_PUBLIC_OKTA_REDIRECT_URI=$NEXT_PUBLIC_OKTA_REDIRECT_URI
ENV NEXT_PUBLIC_OKTA_POST_LOGOUT_REDIRECT_URI=$NEXT_PUBLIC_OKTA_POST_LOGOUT_REDIRECT_URI
ENV NEXT_PUBLIC_OKTA_FUNDING_ACR_VALUES=$NEXT_PUBLIC_OKTA_FUNDING_ACR_VALUES
RUN npx next build apps/web-app

FROM node:24-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
ENV NEXT_TELEMETRY_DISABLED=1

COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts

COPY --from=builder /repo/apps/web-app/.next/standalone ./
COPY --from=builder /repo/apps/web-app/.next/static ./apps/web-app/.next/static
COPY --from=builder /repo/apps/web-app/public ./apps/web-app/public
COPY --from=builder /repo/apps/web-app/telemetry ./apps/web-app/telemetry

WORKDIR /app/apps/web-app
USER node

EXPOSE 3000

CMD ["node", "-r", "./telemetry/register-azure-monitor.cjs", "server.js"]
