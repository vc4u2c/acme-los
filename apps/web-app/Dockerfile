FROM node:24.19.0-bookworm-slim AS deps
WORKDIR /repo
COPY .npmrc package.json package-lock.json ./
RUN npm ci

FROM deps AS builder
WORKDIR /repo
COPY . .
ARG NEXT_PUBLIC_APP_ENVIRONMENT=local
ARG NEXT_PUBLIC_APP_BUILD=
ARG NEXT_PUBLIC_OKTA_ISSUER=
ARG NEXT_PUBLIC_ACME_THEME_COOKIE_DOMAIN=
ARG NEXT_PUBLIC_ACME_ANALYTICS_ENABLED=false
ARG NEXT_PUBLIC_ACME_ANALYTICS_ENVIRONMENT=local
ARG NEXT_PUBLIC_ACME_GTM_CONTAINER_ID=
ARG NEXT_PUBLIC_ACME_GA4_MEASUREMENT_ID=
ARG NEXT_PUBLIC_ACME_ANALYTICS_CONSENT_DEFAULT_ANALYTICS_STORAGE=denied
ARG NEXT_PUBLIC_ACME_ANALYTICS_CONSENT_DEFAULT_AD_STORAGE=denied
ARG NEXT_PUBLIC_ACME_ANALYTICS_CONSENT_DEFAULT_AD_USER_DATA=denied
ARG NEXT_PUBLIC_ACME_ANALYTICS_CONSENT_DEFAULT_AD_PERSONALIZATION=denied
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_PUBLIC_APP_ENVIRONMENT=$NEXT_PUBLIC_APP_ENVIRONMENT
ENV NEXT_PUBLIC_APP_BUILD=$NEXT_PUBLIC_APP_BUILD
ENV NEXT_PUBLIC_OKTA_ISSUER=$NEXT_PUBLIC_OKTA_ISSUER
ENV NEXT_PUBLIC_ACME_THEME_COOKIE_DOMAIN=$NEXT_PUBLIC_ACME_THEME_COOKIE_DOMAIN
ENV NEXT_PUBLIC_ACME_ANALYTICS_ENABLED=$NEXT_PUBLIC_ACME_ANALYTICS_ENABLED
ENV NEXT_PUBLIC_ACME_ANALYTICS_ENVIRONMENT=$NEXT_PUBLIC_ACME_ANALYTICS_ENVIRONMENT
ENV NEXT_PUBLIC_ACME_GTM_CONTAINER_ID=$NEXT_PUBLIC_ACME_GTM_CONTAINER_ID
ENV NEXT_PUBLIC_ACME_GA4_MEASUREMENT_ID=$NEXT_PUBLIC_ACME_GA4_MEASUREMENT_ID
ENV NEXT_PUBLIC_ACME_ANALYTICS_CONSENT_DEFAULT_ANALYTICS_STORAGE=$NEXT_PUBLIC_ACME_ANALYTICS_CONSENT_DEFAULT_ANALYTICS_STORAGE
ENV NEXT_PUBLIC_ACME_ANALYTICS_CONSENT_DEFAULT_AD_STORAGE=$NEXT_PUBLIC_ACME_ANALYTICS_CONSENT_DEFAULT_AD_STORAGE
ENV NEXT_PUBLIC_ACME_ANALYTICS_CONSENT_DEFAULT_AD_USER_DATA=$NEXT_PUBLIC_ACME_ANALYTICS_CONSENT_DEFAULT_AD_USER_DATA
ENV NEXT_PUBLIC_ACME_ANALYTICS_CONSENT_DEFAULT_AD_PERSONALIZATION=$NEXT_PUBLIC_ACME_ANALYTICS_CONSENT_DEFAULT_AD_PERSONALIZATION
RUN npx next build apps/web-app

FROM node:24.19.0-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
ENV NEXT_TELEMETRY_DISABLED=1

COPY .npmrc package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts

COPY --from=builder /repo/apps/web-app/.next/standalone ./
COPY --from=builder /repo/apps/web-app/.next/static ./apps/web-app/.next/static
COPY --from=builder /repo/apps/web-app/public ./apps/web-app/public
COPY --from=builder /repo/apps/web-app/telemetry ./apps/web-app/telemetry

WORKDIR /app/apps/web-app
USER node

EXPOSE 3000

CMD ["node", "-r", "./telemetry/register-azure-monitor.cjs", "server.js"]
