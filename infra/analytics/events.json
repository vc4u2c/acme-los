  "keyEvents": [
    "application_start",
    "application_step_complete",
    "application_submit_succeeded",
    "funding_step_up_completed",
    "generate_lead"
  ],
  "events": [
    {
      "name": "page_view",
      "surface": "client",
      "dispatch": "gtm",
      "description": "One route view after initial load or client-side navigation.",
      "keyEventCandidate": false
    },
    {
      "name": "application_start",
      "surface": "client",
      "dispatch": "google_tag",
      "description": "Applicant starts or resumes the loan application journey.",
      "keyEventCandidate": true
    },
    {
      "name": "application_step_view",
      "surface": "client",
      "dispatch": "google_tag",
      "description": "Applicant views one application step.",
      "keyEventCandidate": false
    },
    {
      "name": "application_step_complete",
      "surface": "client",
      "dispatch": "google_tag",
      "description": "Applicant saves or completes one application step.",
      "keyEventCandidate": true
    },
    {
      "name": "application_submit_clicked",
      "surface": "client",
      "dispatch": "google_tag",
      "description": "Applicant clicks the final submit application action before the request is sent.",
      "keyEventCandidate": false
    },
    {
      "name": "application_submit_succeeded",
      "surface": "client",
      "dispatch": "google_tag",
      "description": "Final application submit returned a successful server response.",
      "keyEventCandidate": true
    },
    {
      "name": "application_submit_failed",
      "surface": "client",
      "dispatch": "google_tag",
      "description": "Final application submit failed with a coarse, non-sensitive failure bucket.",
      "keyEventCandidate": false
    },
    {
      "name": "generate_lead",
      "surface": "client",
      "dispatch": "google_tag",
      "description": "GA4 recommended lead event emitted only after final application submit succeeds.",
      "keyEventCandidate": true,
      "ga4RecommendedEvent": true
    },
    {
      "name": "sign_in_started",
      "surface": "client",
      "dispatch": "google_tag",
      "description": "Hosted sign-in redirect is started from the browser.",
      "keyEventCandidate": false
    },
    {
      "name": "login",
      "surface": "client",
      "dispatch": "google_tag",
      "description": "GA4 recommended login event emitted when an app-started hosted sign-in returns authenticated.",
      "keyEventCandidate": false,
      "ga4RecommendedEvent": true
    },
    {
      "name": "sign_in_failed",
      "surface": "client",
      "dispatch": "google_tag",
      "description": "Hosted sign-in returns to the app with a failure bucket.",
      "keyEventCandidate": false
    },
    {
      "name": "funding_step_up_started",
      "surface": "client",
      "dispatch": "google_tag",
      "description": "Funding assurance challenge is started or expected for the funding step.",
      "keyEventCandidate": false
    },
    {
      "name": "funding_step_up_completed",
      "surface": "client",
      "dispatch": "google_tag",
      "description": "Funding assurance challenge returns with an authenticated AAL2 session.",
      "keyEventCandidate": true
    },
    {
      "name": "preapproval_offer_selected",
      "surface": "client",
      "dispatch": "google_tag",
      "description": "Applicant selects a preapproval offer.",
      "keyEventCandidate": true
    }
  ]
}
