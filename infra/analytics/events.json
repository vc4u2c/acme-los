      "scope": "event"
    },
    {
      "parameterName": "route_group",
      "displayName": "Route group",
      "scope": "event"
    },
    {
      "parameterName": "rendering_mode",
      "displayName": "Rendering mode",
      "scope": "event"
    },
    {
      "parameterName": "auth_state",
      "displayName": "Auth state",
      "scope": "event"
    },
    {
      "parameterName": "assurance_level",
      "displayName": "Assurance level",
      "scope": "event"
    },
    {
      "parameterName": "journey_name",
      "displayName": "Journey name",
      "scope": "event"
    },
    {
      "parameterName": "application_step",
      "displayName": "Application step",
      "scope": "event"
    },
    {
      "parameterName": "step_destination",
      "displayName": "Step destination",
      "scope": "event"
    },
    {
      "parameterName": "auth_context",
      "displayName": "Auth context",
      "scope": "event"
    },
    {
      "parameterName": "result",
      "displayName": "Result",
      "scope": "event"
    },
    {
      "parameterName": "failure_reason_bucket",
      "displayName": "Failure reason bucket",
      "scope": "event"
    },
    {
      "parameterName": "transport_origin",
      "displayName": "Transport origin",
