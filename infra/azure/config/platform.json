{
  "organizationName": "ACME",
  "organizationShortName": "acme",
  "workloadName": "ACME LOS",
  "workloadShortName": "los",
  "projectName": "acme-los",
  "primaryLocation": "centralus",
  "primaryRegionShortName": "cus",
  "resourceNameSuffix": "v42c",
  "platformResources": {
    "monitorResourceGroupName": "rg-acme-hub-monitor-cus-01",
