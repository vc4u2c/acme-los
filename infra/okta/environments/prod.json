{
  "environment": "prod",
  "okta": {
    "issuer": "https://prod-org.okta.com/oauth2/default",
    "webClientId": "replace-with-prod-web-client-id",
    "mobileClientId": "replace-with-prod-mobile-client-id",
    "fundingStepUpAcrValues": "urn:okta:loa:2fa:any",
    "hostedExperience": {
      "rememberUser": true,
      "keepMeSignedIn": true,
      "registrationRequiresEmailVerification": true,
      "registrationRequiresPhoneVerification": false,
      "adaptiveMfaOnSignIn": true,
      "fundingRouteStepUp": true
    }
  },
  "web": {
    "baseUrl": "https://www.acme-los.com",
    "redirectPath": "/auth/callback",
    "postLogoutRedirectPath": "/"
  },
  "mobile": {
    "scheme": "mobile-app",
    "redirectPath": "auth/callback"
  },
  "bff": {
    "baseUrl": "https://api.acme-los.com",
    "loginPath": "/bff/auth/login",
    "callbackPath": "/bff/auth/callback",
    "logoutPath": "/bff/auth/logout",
    "sessionPath": "/bff/auth/session"
  }
}
