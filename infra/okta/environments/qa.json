{
  "environment": "qa",
  "okta": {
    "issuer": "https://qa-org.okta.com/oauth2/default",
    "webClientId": "replace-with-qa-web-client-id",
    "mobileClientId": "replace-with-qa-mobile-client-id",
    "fundingStepUpAcrValues": "urn:okta:loa:2fa:any",
    "telephony": {
      "enabled": false,
      "hookPath": "/api/hooks/okta/telephony"
    },
    "userPrune": {
      "enabled": false,
      "action": "deactivate",
      "keepLogins": []
    },
    "hostedExperience": {
      "rememberUser": true,
      "keepMeSignedIn": true,
      "registrationRequiresEmailVerification": true,
      "registrationRequiresSecurityQuestion": true,
      "registrationRequiresPhoneVerification": false,
      "adaptiveMfaOnSignIn": true,
      "fundingRouteStepUp": true,
      "fundingStepUpMethod": "email",
      "fundingStepUpRequiresPassword": false,
      "recoveryContactHints": true,
      "themeToggle": true
    }
  },
  "web": {
    "baseUrl": "https://qa.acme-los.dev",
    "redirectPath": "/auth/callback",
    "postLogoutRedirectPath": "/"
  },
  "mobile": {
    "scheme": "mobile-app",
    "redirectPath": "auth/callback"
  },
  "bff": {
    "baseUrl": "https://qa-api.acme-los.dev",
    "loginPath": "/bff/auth/login",
    "callbackPath": "/bff/auth/callback",
    "logoutPath": "/bff/auth/logout",
    "sessionPath": "/bff/auth/session"
  }
}
