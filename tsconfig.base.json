{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@acme-los/core/types": ["./libs/core/types/src/index.ts"],
      "@acme-los/core/utils": ["./libs/core/utils/src/index.ts"],
      "@acme-los/core/config": ["./libs/core/config/src/index.ts"],
      "@acme-los/core/logger": ["./libs/core/logger/src/index.ts"],
      "@acme-los/domain/customer": ["./libs/domain/customer/src/index.ts"],
      "@acme-los/domain/application": [
        "./libs/domain/application/src/index.ts"
      ],
      "@acme-los/api/contracts": ["./libs/api/contracts/src/index.ts"],
      "@acme-los/api/web-client": ["./libs/api/web-client/src/index.ts"],
      "@acme-los/api/domain-client": ["./libs/api/domain-client/src/index.ts"],
      "@acme-los/api/web-server": ["./libs/api/web-server/src/index.ts"],
      "@acme-los/auth/contracts": ["./libs/auth/contracts/src/index.ts"],
      "@acme-los/auth/core": ["./libs/auth/core/src/index.ts"],
      "@acme-los/auth/web": ["./libs/auth/web/src/index.ts"],
      "@acme-los/ui-web": ["./libs/ui/web/src/index.ts"],
      "@acme-los/ui-mobile": ["./libs/ui/mobile/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
